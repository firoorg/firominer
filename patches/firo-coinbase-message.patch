+#!/usr/bin/env python3
+"""Solo coinbase tags must identify independent cached FiroPoW jobs."""
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import (
+    assert_equal, assert_raises_jsonrpc, connect_nodes_bi, start_nodes,
+)
+
+
+class CoinbaseMessageTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.num_nodes = 2
+        self.setup_clean_chain = True
+
+    def setup_network(self):
+        self.nodes = start_nodes(2, self.options.tmpdir,
+                                 [["-ppswitchtime=2000000000"] for _ in range(2)])
+        connect_nodes_bi(self.nodes, 0, 1)
+
+    def run_test(self):
+        node = self.nodes[0]
+        # Leave IBD before activating FiroPoW, avoiding an expensive full DAG.
+        node.generate(1)
+        for peer in self.nodes:
+            peer.setmocktime(2000000001)
+        address = node.getnewaddress()
+        other_address = node.getnewaddress()
+        plain = node.getblocktemplate({}, address)
+        first = node.getblocktemplate({"coinbase_message": 'Firo "caf\u00e9"'}, address)
+        second = node.getblocktemplate({"coinbase_message": "another miner"}, address)
+        other_reward = node.getblocktemplate({"coinbase_message": "another miner"}, other_address)
+        assert_equal(first["coinbase_message"], 'Firo "caf\u00e9"')
+        assert_equal(second["coinbase_message"], "another miner")
+        assert_equal(len({item["pprpcheader"] for item in
+                          (plain, first, second, other_reward)}), 4)
+        assert_equal(node.getblocktemplate({}, address)["pprpcheader"], plain["pprpcheader"])
+        assert_equal(node.getblocktemplate({"coinbase_message": "another miner"}, other_address)
+                     ["pprpcheader"], other_reward["pprpcheader"])
+        assert_equal(node.getblocktemplate({"coinbase_message": "\u00e9" * 40}, address)
+                     ["coinbase_message"], "\u00e9" * 40)
+        assert_raises_jsonrpc(-8, "80 UTF-8 bytes", node.getblocktemplate,
+                              {"coinbase_message": "\u00e9" * 41}, address)
+        assert_raises_jsonrpc(-8, "must be a string", node.getblocktemplate,
+                              {"coinbase_message": 123}, address)
+        assert_raises_jsonrpc(-8, "requires reward_address", node.getblocktemplate,
+                              {"coinbase_message": "solo"})
+        # A different miner's request must not evict or mutate an outstanding job.
+        # A deliberately wrong mix reaches solution validation rather than 'Job not found'.
+        for job in (plain, first, second, other_reward):
+            assert_raises_jsonrpc(-32602, "mismatching mix_hash", node.pprpcsb,
+                                  job["pprpcheader"], "0" * 64, "0x0")
+
+
+if __name__ == "__main__":
+    CoinbaseMessageTest().main()
